{
	"name": "omp-sidelight",
	"version": "0.1.1",
	"description": "Long answers from your coding agent, made readable. A full-screen reader for omp where you can ask about any passage on the side, without derailing the conversation.",
	"type": "module",
	"license": "MIT",
	"author": "Mannan Goyal <mannang6@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Mannan-Goyal/omp-sidelight.git"
	},
	"homepage": "https://github.com/Mannan-Goyal/omp-sidelight#readme",
	"bugs": "https://github.com/Mannan-Goyal/omp-sidelight/issues",
	"keywords": ["omp", "omp-plugin", "oh-my-pi", "coding-agent", "ai", "llm", "agent", "reader", "markdown", "explain", "tui", "terminal"],
	"files": ["src", "docs", "README.md", "CHANGELOG.md", "LICENSE"],
	"omp": {
		"extensions": ["./src/index.ts"]
	},
	"engines": {
		"omp": ">=18.11.0"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-ai": "*",
		"@oh-my-pi/pi-coding-agent": "*",
		"@oh-my-pi/pi-tui": "*",
		"@oh-my-pi/pi-utils": "*"
	},
	"peerDependenciesMeta": {
		"@oh-my-pi/pi-ai": { "optional": true },
		"@oh-my-pi/pi-coding-agent": { "optional": true },
		"@oh-my-pi/pi-tui": { "optional": true },
		"@oh-my-pi/pi-utils": { "optional": true }
	},
	"scripts": {
		"test": "node --test test/*.test.ts"
	}
}
